// Waybar configuration for this machine.
// Kept in JSONC so it can carry comments like this one.

{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 26,
  "modules-left": ["custom/omarchy", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["battery"],
  // Omarchy menu button
  "custom/omarchy": {
    "format": "",
    "on-click": "omarchy-menu"
  }
}
