#!/usr/bin/env bash
set -euo pipefail

# Test-only: when $WG_HYPRCTL_LOG is set, record every invocation so a test can
# assert how much work a code path asks of the compositor.
if [[ -n ${WG_HYPRCTL_LOG:-} ]]; then
  printf '%s\n' "$*" >>"$WG_HYPRCTL_LOG"
fi

if [[ ${1:-} == dispatch ]]; then
  shift
  printf '%s\n' "$*" >>"$WG_DISPATCH_LOG"
  # Test-only: with $WG_STUB_GEOMETRY set, a resize actually changes the client
  # fixture, so a test can exercise a pass that measures what it just did. The
  # sign is the honest one -- the window gets the size it asked for -- which is
  # Hyprland's behaviour for the first child of a split.
  if [[ -n ${WG_STUB_GEOMETRY:-} && ${1:-} == resizewindowpixel ]]; then
    if [[ ${2:-} =~ ^exact\ ([0-9]+)\ ([0-9]+),address:(0x[0-9a-fA-F]+)$ ]]; then
      f="${WG_FIXTURE_CLIENTS:-$WG_FIXTURES/clients.json}"
      jq --arg a "${BASH_REMATCH[3]}" \
         --argjson w "${BASH_REMATCH[1]}" --argjson h "${BASH_REMATCH[2]}" \
         'map(if .address == $a then .size = [$w, $h] else . end)' "$f" >"$f.tmp" \
        && mv -f "$f.tmp" "$f"
    fi
  fi
  exit 0
fi

if [[ ${1:-} == -j ]]; then
  case ${2:-} in
    clients) cat "${WG_FIXTURE_CLIENTS:-$WG_FIXTURES/clients.json}" ;;
    activeworkspace) cat "${WG_FIXTURE_ACTIVEWS:-$WG_FIXTURES/activeworkspace.json}" ;;
    monitors) cat "${WG_FIXTURE_MONITORS:-$WG_FIXTURES/monitors.json}" ;;
    workspaces) cat "${WG_FIXTURE_WORKSPACES:-$WG_FIXTURES/workspaces.json}" ;;
    activewindow) cat "${WG_FIXTURE_ACTIVEWINDOW:-$WG_FIXTURES/activewindow.json}" ;;
    *) printf 'hyprctl-stub: unhandled query %s\n' "${2:-}" >&2; exit 1 ;;
  esac
  exit 0
fi

printf 'hyprctl-stub: unhandled invocation %s\n' "$*" >&2
exit 1
