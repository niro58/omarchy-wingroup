#!/usr/bin/env bash
set -euo pipefail
# Test-only stand-in for notify-send: records the notification instead of
# putting one on the user's screen.
#
# The third column is the urgency, which is not decoration: a normal
# notification expires after a few seconds and a critical one stays until it is
# dismissed, and a crash that happens while nobody is looking is the case that
# distinction exists for.
printf '%s\t%s\t%s\n' "${1:-}" "${2:-}" "${3:-}"  >>"$WG_NOTIFY_LOG"
