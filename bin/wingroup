#!/usr/bin/env bash
set -euo pipefail

WG_LIB_DIR="${WG_LIB_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)}"
# shellcheck source=lib/hypr.sh
source "$WG_LIB_DIR/hypr.sh"
# shellcheck source=lib/state.sh
source "$WG_LIB_DIR/state.sh"
# shellcheck source=lib/resolve.sh
source "$WG_LIB_DIR/resolve.sh"
# shellcheck source=lib/menu.sh
source "$WG_LIB_DIR/menu.sh"
# shellcheck source=lib/sessions.sh
source "$WG_LIB_DIR/sessions.sh"

# Tests point this at a stub that replaces /proc lookups with a fixture map.
if [[ -n ${WG_TEST_STUB_CWD:-} ]]; then
  # shellcheck source=test/stub-cwd.sh
  source "$WG_TEST_STUB_CWD"
fi

# Where a user-facing failure has to show up.
#
# A picker action reached from SUPER+G has no terminal behind it: writing to
# stderr there means nobody ever sees it, and the entry looks like it did
# nothing. So a failure with no tty on either standard stream is also sent to
# the notification daemon. A genuine CLI invocation has a terminal and keeps
# plain stderr -- desktop notifications for something already printed in front
# of the user would be noise.
wg_notify() {
  local summary="$1" body="${2:-}"
  if [[ -n ${WG_NOTIFY_CMD:-} ]]; then
    "$WG_NOTIFY_CMD" "$summary" "$body" || true
    return 0
  fi
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send "$summary" "$body" || true
}

wg_has_tty() {
  [[ -t 1 || -t 2 ]]
}

wg_die() {
  printf 'wingroup: %s\n' "$1" >&2
  wg_has_tty || wg_notify "wingroup" "$1"
  exit 1
}

# Something went wrong but the command carries on: same reasoning as wg_die's,
# without the exit.
#
# It matters most for the crashed button. Every way of reaching it -- the click,
# the right click, the picker -- comes from a bar with no terminal behind it, so
# a launcher that is not there, or a directory that has gone, prints to a stderr
# nobody is reading. The user sees the count not go down and has no idea why.
wg_warn() {
  printf 'wingroup: %s\n' "$1" >&2
  wg_has_tty || wg_notify "wingroup" "$1"
}

wg_usage() {
  cat >&2 <<'USAGE'
usage: wingroup <command>

  menu                          open the group and window picker
  send [--address A --group G]  send a window to a group
  activate <slot|name>          switch to a group
  next | prev                   cycle through groups
  tidy [--yes]                  file every window by its project
  new <label> [project...]      create a group
  rename <name> <label>         change a group's displayed label
  dissolve <name>               remove a group, leaving its windows alone
  monitor <group> <name|->      pin a group to a monitor, or clear the pin
  toggle-auto                   turn automatic assignment on or off
  crashed [--menu|--restore|--clear]  list sessions systemd-oomd killed
USAGE
  exit 1
}

wg_slug() {
  local s="$1"
  s="${s,,}"
  s="$(printf '%s' "$s" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  printf '%s\n' "$s"
}

wg_group_exists() {
  local name="$1" state="${2:-$(wg_state_read)}"
  [[ -n "$(jq -r --arg n "$name" 'first(.groups[] | select(.name == $n) | .name) // empty' <<<"$state")" ]]
}

wg_refresh() {
  [[ -n ${WG_REFRESH_CMD:-} ]] && { "$WG_REFRESH_CMD"; return 0; }
  pkill -RTMIN+11 waybar || true
}

cmd_activate() {
  local target="${1:?}" state monitor lives_on
  local -a names=()
  state="$(wg_state_read)"
  mapfile -t names < <(wg_state_group_names "$state")

  if [[ $target =~ ^[0-9]+$ ]] && (( target < ${#names[@]} )); then
    target="${names[target]}"
  fi
  wg_group_exists "$target" "$state" || wg_die "no such group: $target"

  # A group with no pin is switched to exactly as it always was.
  monitor="$(wg_state_group_field "$target" monitor "$state")"
  if [[ -n $monitor ]]; then
    # Hyprland creates a named workspace on whichever monitor has focus at the
    # time, and it stays bound there. A group first opened from the laptop
    # therefore lives on the laptop for good -- so focusing the pinned monitor
    # is not enough on its own, the workspace has to be dragged over to it.
    # That move is the whole feature.
    wg_hypr_dispatch focusmonitor "$monitor"
    lives_on="$(wg_hypr_query workspaces \
      | jq -r --arg w "$target" 'first(.[] | select(.name == $w) | .monitor) // empty')"
    if [[ -n $lives_on && $lives_on != "$monitor" ]]; then
      wg_hypr_dispatch moveworkspacetomonitor "name:$target $monitor"
    fi
  fi

  wg_hypr_dispatch workspace "name:$target"
}

# monitor <group> <monitor-name> pins; monitor <group> - clears the pin.
cmd_monitor() {
  local name="${1:?usage: wingroup monitor <group> <monitor-name|->}"
  local monitor="${2:?usage: wingroup monitor <group> <monitor-name|->}"
  local state
  state="$(wg_state_read)"
  wg_group_exists "$name" "$state" || wg_die "no such group: $name"

  if [[ $monitor == - ]]; then
    # shellcheck disable=SC2016  # $n is a jq variable, not a shell one
    wg_state_update '(.groups[] | select(.name == $n) | .monitor) = null' --arg n "$name"
    wg_refresh
    return 0
  fi

  local -a monitors=()
  local m found=0 available=""
  mapfile -t monitors < <(wg_hypr_query monitors | jq -r '.[].name')
  for m in ${monitors[@]+"${monitors[@]}"}; do
    available+="${available:+, }$m"
    if [[ $m == "$monitor" ]]; then found=1; fi
  done
  (( found )) || wg_die "no such monitor: $monitor (available: ${available:-none})"

  # shellcheck disable=SC2016  # $n and $m are jq variables, not shell ones
  wg_state_update '(.groups[] | select(.name == $n) | .monitor) = $m' \
    --arg n "$name" --arg m "$monitor"
  wg_refresh
}

cmd_cycle() {
  local direction="$1" active index=-1 i
  local -a names=()
  mapfile -t names < <(wg_state_group_names)
  (( ${#names[@]} )) || wg_die "no groups defined"

  active="$(wg_hypr_query activeworkspace | jq -r '.name')"
  for (( i = 0; i < ${#names[@]}; i++ )); do
    [[ ${names[i]} == "$active" ]] && { index=$i; break; }
  done

  if (( index < 0 )); then
    index=$(( direction == 1 ? -1 : 0 ))
  fi
  index=$(( (index + direction + ${#names[@]}) % ${#names[@]} ))
  wg_hypr_dispatch workspace "name:${names[index]}"
}

# The group cmd_new last created, and how many windows it filed onto it. Its
# callers -- the picker's "+ new group…" and the send picker -- need both, and
# a subshell would lose them.
WG_NEW_NAME=""
WG_NEW_MOVED=0

cmd_new() {
  local label="${1:?usage: wingroup new <label> [project...]}"; shift
  local state name projects
  WG_NEW_NAME=""
  WG_NEW_MOVED=0
  state="$(wg_state_read)"
  name="$(wg_slug "$label")"
  [[ -n $name ]] || wg_die "label produces an empty group name"
  wg_group_exists "$name" "$state" && wg_die "group already exists: $name"
  projects="$(printf '%s\n' ${@+"$@"} | jq -R -s 'split("\n") | map(select(length > 0))')"
  # The duplicate check above reads a copy taken before the lock, so it stays a
  # message rather than a guarantee; the filter itself refuses to add a second
  # group of the same name, which is the half that has to hold under a race.
  # shellcheck disable=SC2016  # $n, $l and $p are jq variables, not shell ones
  wg_state_update 'if any(.groups[]; .name == $n) then . else
      .groups += [{name: $n, label: $l, projects: $p, monitor: null}] end' \
    --arg n "$name" --arg l "$label" --argjson p "$projects"
  WG_NEW_NAME="$name"

  # A group that owns no project cannot own a window yet -- an override names a
  # group that already existed when the window was sent to it -- so there is
  # nothing to file, and no reason to ask the compositor for the window table.
  if (( $# )); then
    WG_NEW_MOVED="$(wg_group_file_windows "$name")"
  fi
  wg_refresh
  if (( WG_NEW_MOVED > 0 )); then
    printf 'wingroup: filed %s window(s) onto %s\n' "$WG_NEW_MOVED" "$name"
  fi
}

# The picker's "+ new group…".
#
# Prompting is the whole reason this used to be a dead entry: dmenu mode returns
# a choice, not typed text. walker's -I/--inputonly is dmenu mode with nothing
# but the input box, which is the missing half.
#
# Creation goes through cmd_new, so slugification and the duplicate check are
# the ones `wingroup new` has. A group with no projects is inert, though, so if
# the window the user is looking at sits in a project no group has claimed, that
# project seeds the new group -- which is the case where someone reaches for
# this entry in the first place.
cmd_new_interactive() {
  local label project="" owner="" address row state

  label="$(wg_menu_input 'New group')"
  [[ -n $label ]] || return 0

  address="$(wg_hypr_query activewindow | jq -r '.address // empty')"
  if [[ -n $address && $address != null ]]; then
    row="$(wg_window_row "$address")"
    # Column 7 is the project; a row is nine tab-separated columns and several
    # of them are routinely empty, so cut, never a multi-variable read.
    [[ -z $row ]] || project="$(cut -f7 <<<"$row")"
  fi

  state="$(wg_state_read)"
  if [[ -n $project ]]; then
    owner="$(wg_project_group "$project" "$state")"
  fi

  local body
  if [[ -n $project && -z $owner ]]; then
    cmd_new "$label" "$project"
    body="Created group $label with project $project."
  elif [[ -n $owner ]]; then
    cmd_new "$label"
    body="Created group $label with no projects: $project already belongs to $owner."
  else
    cmd_new "$label"
    body="Created group $label with no projects: the focused window is not in a project."
  fi
  # The windows cmd_new just filed onto it: a group that claims windows moves
  # them, and the notification is the only place a picker action can say so.
  if (( WG_NEW_MOVED > 0 )); then
    body+=" Filed $WG_NEW_MOVED window(s) onto it."
  fi
  wg_notify "wingroup" "$body"
}

# The picker's "− remove a group…".
#
# `wingroup dissolve` has always existed, but only in a terminal -- a group made
# by mistake from the picker could not be unmade from it. Two steps, because
# there is no undo: pick which group, then confirm that one by name.
#
# Semantics are dissolve's, unchanged: the group and any overrides pointing at
# it go, and not one window is closed, moved or otherwise touched. Windows
# sitting on the workspace stay exactly where they are.
cmd_delete_interactive() {
  local state action name label confirm

  state="$(wg_state_read)"
  if [[ -z "$(wg_state_group_names "$state")" ]]; then
    wg_notify "wingroup" "There are no groups to remove."
    return 0
  fi

  action="$(wg_group_list_build "$state" | wg_menu_run 'Remove which group?')"
  [[ -n $action ]] || return 0
  name="${action#group:}"

  label="$(wg_state_group_field "$name" label "$state")"
  [[ -n $label ]] || label="$name"

  confirm="$(wg_delete_confirm_build "$name" "$label" | wg_menu_run "Remove $label?")"
  [[ $confirm == "delete:$name" ]] || return 0

  cmd_dissolve "$name"
  wg_notify "wingroup" "Removed group $label. Its windows were left where they are."
}

cmd_rename() {
  local name="${1:?}" label="${2:?}" state
  state="$(wg_state_read)"
  wg_group_exists "$name" "$state" || wg_die "no such group: $name"
  # shellcheck disable=SC2016  # $n and $l are jq variables, not shell ones
  wg_state_update '(.groups[] | select(.name == $n) | .label) = $l' \
    --arg n "$name" --arg l "$label"
  wg_refresh
}

cmd_dissolve() {
  local name="${1:?}" state
  state="$(wg_state_read)"
  wg_group_exists "$name" "$state" || wg_die "no such group: $name"
  # shellcheck disable=SC2016  # $n is a jq variable, not a shell one
  wg_state_update \
    '.groups |= map(select(.name != $n)) | .overrides |= with_entries(select(.value != $n))' \
    --arg n "$name"
  wg_refresh
}

cmd_send() {
  local address="" group="" state
  while (( $# )); do
    case $1 in
      --address) address="$2"; shift 2 ;;
      --group)   group="$2";   shift 2 ;;
      *) wg_usage ;;
    esac
  done

  [[ -n $address ]] || address="$(wg_hypr_query activewindow | jq -r '.address')"
  [[ -n $address && $address != null ]] || wg_die "no window to send"

  if [[ -z $group ]]; then
    local action
    # shellcheck disable=SC2119  # no args intended: build the menu for the current state
    action="$(wg_group_menu_build | wg_menu_run 'Send to group')"
    [[ -n $action ]] || return 0
    if [[ $action == new ]]; then
      # The same prompt SUPER+G's "+ new group…" opens, and the same creation
      # behind it -- then carry on and send the window to what it made. A
      # cancelled prompt creates nothing, so there is nothing to send to.
      cmd_new_interactive
      [[ -n $WG_NEW_NAME ]] || return 0
      group="$WG_NEW_NAME"
    else
      group="${action#group:}"
    fi
  fi

  state="$(wg_state_read)"
  wg_group_exists "$group" "$state" || wg_die "no such group: $group"
  # shellcheck disable=SC2016  # $a and $g are jq variables, not shell ones
  wg_state_update '.overrides[$a] = $g' --arg a "$address" --arg g "$group"
  wg_hypr_dispatch movetoworkspacesilent "name:$group,address:$address"
  wg_refresh
}

# Prints one "address<TAB>group" line per window that is on the wrong workspace.
#
# With $1 given, only that group's windows are considered -- same skips, same
# resolution, just narrowed. That is what a freshly created group needs: the
# windows it now owns are already open somewhere else, and nothing else on the
# desktop should be touched on its account.
#
# NOTE: rows come from wg_window_table's nine tab-separated columns, and the
# group/worktree columns are frequently empty. Bash's `read` treats tab as
# IFS whitespace, so a multi-variable `IFS=$'\t' read -r a b c ...` silently
# collapses consecutive tabs and strips leading ones -- an empty interior
# column would shift every field after it (e.g. status landing in $group).
# Read each row whole and pull columns out with `cut` instead.
wg_tidy_moves() {
  local only="${1:-}"
  local state line address workspace floating group
  state="$(wg_state_read)"
  while IFS= read -r line; do
    floating="$(cut -f4 <<<"$line")"
    [[ $floating == "true" ]] && continue
    group="$(cut -f5 <<<"$line")"
    [[ -n $group ]] || continue
    [[ -z $only || $group == "$only" ]] || continue
    workspace="$(cut -f3 <<<"$line")"
    [[ $workspace == "$group" ]] && continue
    address="$(cut -f1 <<<"$line")"
    [[ "$(jq -r --arg a "$address" '.overrides[$a] // empty' <<<"$state")" == "" ]] || continue
    printf '%s\t%s\n' "$address" "$group"
  done < <(wg_window_table)
}

# Files every open window that resolves to group $1 onto $1's workspace, and
# prints how many it moved.
#
# Counting a window in a group while it sits on some other workspace is the
# whole complaint this answers: the bar said "other -- 1 window", activating the
# group showed an empty workspace, because creating a group never moved the
# windows it had just claimed. Membership and location have to agree.
#
# The skips are wg_tidy_moves' skips, because this *is* wg_tidy_moves, narrowed
# to one group: a floating window is left floating, a window already on the
# right workspace is not dispatched at, and a window whose group was chosen by
# hand (an override) keeps the group it was sent to.
wg_group_file_windows() {
  local group="$1" moves count=0 address target
  moves="$(wg_tidy_moves "$group")"
  [[ -n $moves ]] || { printf '0\n'; return 0; }
  while IFS=$'\t' read -r address target; do
    [[ -n $address ]] || continue
    wg_hypr_dispatch movetoworkspacesilent "name:$target,address:$address"
    count=$(( count + 1 ))
  done <<<"$moves"
  printf '%s\n' "$count"
}

cmd_tidy() {
  local assume_yes=0 moves count address group
  [[ ${1:-} == --yes ]] && assume_yes=1
  # shellcheck disable=SC2119  # no args intended: every group, not one of them
  moves="$(wg_tidy_moves)"
  [[ -n $moves ]] || return 0
  count="$(wc -l <<<"$moves")"

  if (( ! assume_yes )); then
    local action
    action="$(printf 'tidy\tApply %s move(s)\nnoop\tCancel\n' "$count" | wg_menu_run 'Tidy')"
    [[ $action == tidy ]] || return 0
  fi

  while IFS=$'\t' read -r address group; do
    wg_hypr_dispatch movetoworkspacesilent "name:$group,address:$address"
  done <<<"$moves"
  wg_refresh
}

cmd_toggle_auto() {
  wg_state_update '.auto = (.auto | not)'
  wg_refresh
}

# One wg_crashed_rows line into WG_CRASH[1..3] -- session id, directory, time.
# The array index is the column number, as with WG_ROW.
#
# Peeled apart by expansion rather than `IFS=$'\t' read -r a b c`: the session id
# is empty for a session that was already running when the hook was installed,
# and tab is IFS whitespace, so read would collapse that empty column and slide
# the directory into the id -- exactly the trap wg_row_split exists for, and
# here it would relaunch `claude --resume /home/me/project`.
declare -ga WG_CRASH=()

wg_crash_split() {
  local rest="$1"
  WG_CRASH=("" "${rest%%$'\t'*}")
  rest="${rest#*$'\t'}"
  WG_CRASH+=("${rest%%$'\t'*}" "${rest#*$'\t'}")
}

# Opens the terminal for one crashed record, backgrounded, and leaves its pid in
# WG_CRASH_PID. Returns non-zero -- having launched nothing at all -- when the
# directory is gone.
#
# Both restore paths come through here: --restore sweeps the whole list, the
# picker relaunches the one entry that was chosen, and the terminal they open
# has to be the same terminal. The launch stays backgrounded so a sweep can
# start a dozen at once; what waiting for it means is the caller's business.
WG_CRASH_PID=""

wg_crash_launch() {
  local session="$1" cwd="$2"
  WG_CRASH_PID=""

  # A worktree that has since been removed, or a project that moved. There is
  # nowhere to put the terminal, and opening it in $HOME instead would be a
  # session in the wrong place under the right name.
  if [[ ! -d $cwd ]]; then
    wg_warn "skipped $cwd — the directory is gone"
    return 1
  fi

  # The shape restore-claude.sh uses, for its reasons: the launcher puts the
  # terminal in a scope of its own, and the shell that outlives a failed
  # --resume is what keeps the window -- and the error in it -- on screen,
  # instead of the terminal vanishing the moment claude exits.
  if [[ -n $session ]]; then
    printf 'wingroup: resuming %s in %s\n' "$session" "$cwd"
    # shellcheck disable=SC2016  # $0 belongs to bash -c, which expands it
    "${WG_LAUNCH_CMD:-uwsm-app}" -- xdg-terminal-exec --dir="$cwd" -- \
      bash -c 'claude --resume "$0" || { echo; echo "resume failed for $0"; exec bash; }' "$session" \
      >/dev/null &
  else
    # No id was ever recorded for this one: it was running before the hook was
    # installed, and a scan can only see that *something* was in that directory.
    # A fresh claude there is the most that can be offered, and saying so is the
    # point -- the conversation is not coming back.
    printf 'wingroup: no session id for %s — starting a fresh claude there\n' "$cwd"
    "${WG_LAUNCH_CMD:-uwsm-app}" -- xdg-terminal-exec --dir="$cwd" -- \
      bash -c 'claude || { echo; echo "claude exited"; exec bash; }' \
      >/dev/null &
  fi
  WG_CRASH_PID="$!"
}

# The picker behind the bar's ⚠ button.
#
# Restore-all first: losing several sessions at once is the case this exists
# for, and relaunching the lot is what you almost always want afterwards. The
# individual sessions come next, so an Enter pressed a row too early lands on
# that bulk action rather than on one arbitrary record. Dismissing is last,
# because it is the only entry that throws the session ids away for good.
wg_crashed_menu_build() {
  local -a rows=("$@")
  local i note

  printf 'restore-all\t⟳ Restore all (%s)\n' "${#rows[@]}"
  for (( i = 0; i < ${#rows[@]}; i++ )); do
    wg_crash_split "${rows[i]}"
    # The difference between getting the conversation back and getting only the
    # directory back, which is worth knowing before picking a row.
    if [[ -n ${WG_CRASH[1]} ]]; then
      note="resumable"
    else
      note="no session id, a fresh claude"
    fi
    printf 'crash:%d\t  %-44s %s  %s\n' "$i" "${WG_CRASH[2]}" "${WG_CRASH[3]}" "$note"
  done
  printf 'dismiss-all\t✕ Dismiss all — forget these %s\n' "${#rows[@]}"
}

# What the picker's answer means. $@ is the row list it was built from, so the
# index in a crash: action still counts the records it was shown.
#
# That holds because of two things, and it is worth naming both. The watcher
# only ever appends, so a crash arriving while the picker is open shifts no
# existing index. And the caller holds wingroup-crashed.lock, so no second
# picker can be removing records underneath this one -- without that, two open
# pickers each acting on "index 0" delete two different sessions and relaunch
# one of them twice.
cmd_crashed_menu() {
  local -a rows=("$@")
  local action index

  action="$(wg_crashed_menu_build "${rows[@]}" | wg_menu_run 'Crashed sessions')"
  case $action in
    # Cancelled: nothing was chosen, so nothing happens -- not even a refresh.
    "") return 0 ;;
    # The two bulk entries are the flags this command already has, behaviour and
    # messages included. Keeping the whole list when a launch fails is
    # --restore's job, and it stays --restore's job when it is the picker doing
    # the asking.
    restore-all) cmd_crashed --restore ;;
    dismiss-all) cmd_crashed --clear ;;
    crash:*)
      index="${action#crash:}"
      wg_crash_split "${rows[index]}"
      # A directory that is gone is skipped here as it is under --restore, and
      # the record is left alone: --restore may drop it because that sweep ends
      # with an empty list either way, whereas here the user aimed at one entry
      # and nothing happened, so nothing changes. The notification is because
      # this picker is opened from the bar, where a message printed on stdout
      # has no terminal to land in.
      if ! wg_crash_launch "${WG_CRASH[1]}" "${WG_CRASH[2]}"; then
        wg_notify "wingroup" "Cannot restore ${WG_CRASH[2]}: the directory is gone."
        return 0
      fi
      # Waited on before the record goes, for the reason --restore waits: this
      # file is the only surviving copy of the session id, so a launcher that is
      # not there must not cost the user the one thing they came back for.
      if ! wait "$WG_CRASH_PID"; then
        printf 'wingroup: the launch failed — keeping the record so the session id is not lost\n' >&2
        return 1
      fi
      wg_crashed_remove "$index"
      wg_refresh
      ;;
  esac
}

# The sessions systemd-oomd killed, and what to do about them.
#
# This only ever reads a file. Everything in it was written while those sessions
# were alive, because none of it survives them: the process is gone, and all the
# journal knows is which scope died. See lib/sessions.sh.
cmd_crashed() {
  local restore=0 clear=0 menu=0
  while (( $# )); do
    case $1 in
      --restore) restore=1; shift ;;
      --clear)   clear=1;   shift ;;
      --menu)    menu=1;    shift ;;
      *) wg_usage ;;
    esac
  done
  # The usage line offers these as alternatives, so accepting a combination and
  # quietly honouring one of them would make the usage a lie. --menu in
  # particular wins over everything below it, so `--menu --restore` used to open
  # a picker and drop the restore without a word.
  (( restore + clear + menu <= 1 )) || wg_usage

  local -a rows=()
  mapfile -t rows < <(wg_crashed_rows)

  if (( ${#rows[@]} == 0 )); then
    printf 'wingroup: no crashed sessions — nothing has been oom-killed since boot\n'
    return 0
  fi

  # Below the empty check, so the button on a bar that has nothing to flag says
  # so rather than putting an empty picker on the screen.
  if (( menu )); then
    # One picker at a time, and this lock is not politeness -- it is what makes
    # restoring a single session safe at all.
    #
    # A record is identified by its position in the list, because the field that
    # names one is the scope and a scope cannot survive being read back out of a
    # row. Position is only meaningful while the list does not move underneath
    # the reader. Two pickers open at once -- one bar button, one double click --
    # both offer index 0, the first pick deletes it, and the second pick then
    # deletes what is *now* index 0: a different session, never relaunched, and
    # its id gone with it. Which is the one thing this whole feature exists to
    # stop happening.
    #
    # Non-blocking, like the group picker's: a second click does nothing rather
    # than queueing a second window behind the first.
    local lock="${XDG_RUNTIME_DIR:-/tmp}/wingroup-crashed.lock"
    exec 9>"$lock"
    flock -n 9 || return 0
    cmd_crashed_menu "${rows[@]}"
    return
  fi

  # --clear is the "I have dealt with these myself" exit: nothing is relaunched,
  # and the bar stops flagging groups that are fine again.
  if (( clear && ! restore )); then
    wg_crashed_clear
    wg_refresh
    printf 'wingroup: cleared %s crashed session(s)\n' "${#rows[@]}"
    return 0
  fi

  local row
  if (( ! restore )); then
    printf '%s session(s) killed by systemd-oomd:\n' "${#rows[@]}"
    for row in "${rows[@]}"; do
      wg_crash_split "$row"
      if [[ -n ${WG_CRASH[1]} ]]; then
        printf '  %s  %s  resumable\n' "${WG_CRASH[3]}" "${WG_CRASH[2]}"
      else
        printf '  %s  %s  no session id, a fresh claude\n' "${WG_CRASH[3]}" "${WG_CRASH[2]}"
      fi
    done
    return 0
  fi

  local launched=0 skipped=0
  local -a pids=()
  for row in "${rows[@]}"; do
    wg_crash_split "$row"
    if wg_crash_launch "${WG_CRASH[1]}" "${WG_CRASH[2]}"; then
      pids+=("$WG_CRASH_PID")
      launched=$(( launched + 1 ))
    else
      skipped=$(( skipped + 1 ))
    fi
  done

  # The launches are backgrounded so that a dozen terminals start at once rather
  # than one after another, then waited for one at a time.
  #
  # One at a time, and not a bare `wait`, because a bare `wait` returns 0 no
  # matter how its children fared -- and this list is the only surviving record
  # of the session ids. A launcher that is not there (no terminal configured for
  # xdg-terminal-exec, uwsm-app outside a uwsm session) would otherwise report a
  # successful relaunch, clear the file, and take every id with it. Their stderr
  # is left alone for the same reason: a launch that fails has to be visible.
  local failed=0 p
  for p in ${pids[@]+"${pids[@]}"}; do
    wait "$p" || failed=$(( failed + 1 ))
  done

  if (( ! failed )); then
    # Cleared whole, skips included: a record whose directory is gone can never
    # be restored, so leaving it in would flag its group on the bar forever.
    wg_crashed_clear
  fi
  wg_refresh

  # $launched counts the terminals asked for; only the ones that came back are
  # reported as relaunched. Saying "relaunched 3" after three launchers failed
  # is the same lie the bare `wait` used to tell.
  local restored=$(( launched - failed ))
  if (( skipped )); then
    printf 'wingroup: relaunched %s session(s), skipped %s\n' "$restored" "$skipped"
  else
    printf 'wingroup: relaunched %s session(s)\n' "$restored"
  fi

  if (( failed )); then
    # Through wg_warn, because the commonest way to reach this is the bar's
    # right click, and stderr there goes nowhere: the terminals would fail to
    # appear, the count would not go down, and nothing would say why.
    wg_warn "$failed launch(es) failed — keeping the list so the session ids are not lost"
    # Non-zero as well as loud. The message is for a person; a script that runs
    # this to empty the list has to be able to find out from the exit status
    # that the list is still full.
    return 1
  fi
}

# SUPER+G with a picker already on screen must not open a second one. The bar's
# right-click and the keybind reach the same command, and the picker used to
# take long enough that pressing again looked like the only sane response.
#
# Same single-instance lock the daemon takes, and the same reason for -n: if it
# is held, the picker the user wants is already in front of them, so exit
# quietly rather than queue up behind it.
cmd_menu() {
  local lock="${XDG_RUNTIME_DIR:-/tmp}/wingroup-menu.lock"
  exec 9>"$lock"
  flock -n 9 || return 0

  local action
  # shellcheck disable=SC2119  # no args intended: build the menu for the current state
  action="$(wg_menu_build | wg_menu_run 'Groups')"
  case $action in
    "")            return 0 ;;
    group:*)       cmd_activate "${action#group:}" ;;
    window:*)      wg_hypr_dispatch focuswindow "address:${action#window:}" ;;
    new)           cmd_new_interactive ;;
    delete)        cmd_delete_interactive ;;
    tidy)          cmd_tidy ;;
    toggle-auto)   cmd_toggle_auto ;;
  esac
}

main() {
  local command="${1:-}"
  [[ -n $command ]] || wg_usage
  shift || true
  case $command in
    menu)        cmd_menu "$@" ;;
    send)        cmd_send "$@" ;;
    activate)    cmd_activate "$@" ;;
    next)        cmd_cycle 1 ;;
    prev)        cmd_cycle -1 ;;
    tidy)        cmd_tidy "$@" ;;
    new)         cmd_new "$@" ;;
    rename)      cmd_rename "$@" ;;
    dissolve)    cmd_dissolve "$@" ;;
    monitor)     cmd_monitor "$@" ;;
    toggle-auto) cmd_toggle_auto ;;
    crashed)     cmd_crashed "$@" ;;
    *)           wg_usage ;;
  esac
}

main "$@"
