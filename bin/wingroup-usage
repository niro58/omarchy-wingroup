#!/usr/bin/env bash
# What is left of each Claude account, written where the bar can read it.
#
# The transcripts on disk say what has been spent; nothing in them says what
# remains. The only thing on the machine that knows is the endpoint Claude
# Code's own /usage reads, so this asks that, once per registered account, with
# that account's own OAuth token out of that account's own configuration
# directory. One small JSON record per account lands in the usage directory, and
# the bar watches the directory.
#
# Omarchy ships a collector of its own and this is not it. That one scans every
# transcript on the machine to build a history, under a lock, and on a desktop
# with a few hundred thousand prompts it does not come back inside ninety
# seconds -- measured. It also knows one account, because it reads
# CLAUDE_CONFIG_DIR from its environment and there is only one environment. What
# is wanted here is the cheap half -- two windows and when they reset -- for
# several accounts, often enough to be worth looking at.
#
# The token is read, sent, and never written down. Not into a record, not into
# an error, not into a log. The tests beside this file check that by grepping
# everything it wrote for the token it was given.
set -uo pipefail

WG_LIB_DIR="${WG_LIB_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)}"
# shellcheck source=lib/state.sh
source "$WG_LIB_DIR/state.sh"
# shellcheck source=lib/sessions.sh
source "$WG_LIB_DIR/sessions.sh"
# shellcheck source=lib/accounts.sh
source "$WG_LIB_DIR/accounts.sh"

: "${WG_USAGE_DIR:=$WG_STATE_DIR/usage}"
: "${WG_USAGE_ENDPOINT:=https://api.anthropic.com/api/oauth/usage}"
# Seconds. Short on purpose: this runs on a timer behind a bar, and a reading
# that arrives late is worth less than one that admits it could not be taken.
: "${WG_USAGE_TIMEOUT:=15}"
# Where the body lands while curl reports the status separately.
: "${WG_USAGE_BODY:=${TMPDIR:-/tmp}/wingroup-usage.$$}"

# Asks the endpoint for one account. $1 is the account's directory, $2 the
# token. Prints the HTTP status on the first line and the body after it.
#
# The status is printed rather than returned because the three answers that
# matter are not "worked" and "failed": 200 is a reading, 401 is an account that
# has to be logged in again, and anything else -- no network, a 500, a proxy --
# is a reading that could not be taken. An exit code cannot carry that without
# inventing a second vocabulary for curl's, and "000" is what curl itself writes
# when it never got an answer at all.
#
# Replaced wholesale in the tests, which is why the token is a parameter rather
# than something this reaches for itself.
wg_usage_fetch() {
  local dir="$1" token="$2"
  if [[ -n ${WG_USAGE_FETCH:-} ]]; then
    "$WG_USAGE_FETCH" "$dir" "$token"
    return $?
  fi
  curl -sS --max-time "$WG_USAGE_TIMEOUT" \
    -w '%{http_code}\n' -o "$WG_USAGE_BODY" \
    -H "Authorization: Bearer $token" \
    -H "anthropic-beta: oauth-2025-04-20" \
    "$WG_USAGE_ENDPOINT" 2>/dev/null || printf '000\n'
  cat "$WG_USAGE_BODY" 2>/dev/null
  rm -f "$WG_USAGE_BODY"
}

# One account's record. $1 name, $2 whether it is the active one, $3 the state,
# and $4 the body when there is one.
wg_usage_write() {
  local name="$1" active="$2" state="$3" body="${4:-}"
  local tmp="$WG_USAGE_DIR/.$name.$$"
  mkdir -p "$WG_USAGE_DIR" || return 1
  # The percentages are pulled out here rather than in the widget: the bar
  # should not have to know the shape of somebody else's API, and when that
  # shape changes this is the one file that has to follow it.
  if ! jq -n --arg name "$name" --arg state "$state" --argjson active "$active" \
        --arg now "$(date +%s)" --argjson body "${body:-null}" '
        {name: $name, state: $state, active: $active, taken_at: ($now | tonumber)}
        + (if $body == null then {} else
            {five_hour_percent: ($body.five_hour.utilization // null),
             five_hour_resets_at: ($body.five_hour.resets_at // null),
             seven_day_percent: ($body.seven_day.utilization // null),
             seven_day_resets_at: ($body.seven_day.resets_at // null),
             opus_percent: ($body.seven_day_opus.utilization // null),
             sonnet_percent: ($body.seven_day_sonnet.utilization // null)}
            | with_entries(select(.value != null))
           end)' >"$tmp" 2>/dev/null; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$WG_USAGE_DIR/$name.json"
}

wg_usage_one() {
  local name="$1" active="$2" dir creds token answer code body

  dir="$(wg_account_dir "$name")"
  creds="$dir/.credentials.json"
  if [[ ! -r $creds ]]; then
    wg_usage_write "$name" "$active" needs-login
    return 0
  fi
  token="$(jq -r '.claudeAiOauth.accessToken // empty' "$creds" 2>/dev/null)"
  if [[ -z $token ]]; then
    wg_usage_write "$name" "$active" needs-login
    return 0
  fi

  answer="$(wg_usage_fetch "$dir" "$token")"
  # Whatever happens from here on, the token is out of scope: nothing below is
  # allowed to carry it.
  unset token

  code="${answer%%$'\n'*}"
  body="${answer#*$'\n'}"
  [[ $body != "$answer" ]] || body=""

  case $code in
    200) ;;
    401 | 403)
      # The token is there and the endpoint will not take it: expired, revoked,
      # or an account logged out somewhere else.
      wg_usage_write "$name" "$active" needs-login
      return 0 ;;
    *)
      wg_usage_write "$name" "$active" unreachable
      return 0 ;;
  esac
  if ! jq -e . <<<"$body" >/dev/null 2>&1; then
    # A 200 that is not JSON -- a captive portal, a maintenance page, a proxy
    # being helpful. Recording it as a reading of zero would send the next
    # session to an account that may have nothing left.
    wg_usage_write "$name" "$active" unreadable
    return 0
  fi
  wg_usage_write "$name" "$active" ok "$body"
}

wg_usage_main() {
  local name active known=""
  active="$(wg_account_active)"
  mkdir -p "$WG_USAGE_DIR" || return 1

  while IFS= read -r name; do
    [[ -n $name ]] || continue
    known+="$name"$'\n'
    if [[ $name == "$active" ]]; then
      wg_usage_one "$name" true
    else
      wg_usage_one "$name" false
    fi
  done < <(wg_account_list)

  # An account that has been forgotten should stop being on the bar. Its record
  # would otherwise sit there at whatever it last read, which is a number about
  # an account that is no longer part of the rotation.
  local file base
  for file in "$WG_USAGE_DIR"/*.json; do
    [[ -e $file ]] || continue
    base="${file##*/}"; base="${base%.json}"
    grep -qxF "$base" <<<"$known" || rm -f "$file"
  done
  return 0
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  wg_usage_main
fi
