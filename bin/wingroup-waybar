#!/usr/bin/env bash
set -euo pipefail

WG_LIB_DIR="${WG_LIB_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)}"
# shellcheck source=lib/hypr.sh
source "$WG_LIB_DIR/hypr.sh"
# shellcheck source=lib/state.sh
source "$WG_LIB_DIR/state.sh"
# shellcheck source=lib/resolve.sh
source "$WG_LIB_DIR/resolve.sh"
# shellcheck source=lib/constants.sh
source "$WG_LIB_DIR/constants.sh"
# shellcheck source=lib/sessions.sh
source "$WG_LIB_DIR/sessions.sh"

# Tests point this at a stub that replaces /proc lookups with a fixture map.
if [[ -n ${WG_TEST_STUB_CWD:-} ]]; then
  # shellcheck source=test/stub-cwd.sh
  source "$WG_TEST_STUB_CWD"
fi

wg_superscript() {
  local n="$1" out="" i
  local sup=("⁰" "¹" "²" "³" "⁴" "⁵" "⁶" "⁷" "⁸" "⁹")
  [[ $n =~ ^[0-9]+$ ]] || return 0
  (( n > 0 )) || return 0
  for (( i = 0; i < ${#n}; i++ )); do
    out+="${sup[${n:i:1}]}"
  done
  printf '%s\n' "$out"
}

# $1 text, $2 tooltip, then zero or more CSS classes.
#
# waybar takes a custom module's "class" as either a string or an array of
# strings (waybar-custom(5): "The class parameter also accepts an array of
# strings"), and only the array form puts more than one class on the widget --
# a string with a space in it becomes one GTK class literally named "busy
# idle1", which no selector matches. So: one class stays the plain string this
# module has always emitted, several go out as the array, and a selector like
# #custom-wingroup0.active.idle3 matches both of the classes it names.
wg_emit() {
  local text="$1" tooltip="$2"
  shift 2
  if (( $# > 1 )); then
    jq -cn --arg text "$text" --arg tooltip "$tooltip" --args \
      '{text: $text, tooltip: $tooltip, class: $ARGS.positional}' "$@"
  else
    jq -cn --arg text "$text" --arg tooltip "$tooltip" --arg class "${1-}" \
      '{text: $text, tooltip: $tooltip, class: $class}'
  fi
}

# The standalone crash button at the end of the bar: how many Claude sessions
# systemd-oomd has taken, and what they were. It belongs to no group -- the
# count is the whole machine's -- which is why it is a module of its own rather
# than another fact hung on a slot.
#
# Same budget as the crash line inside a slot, and for the same reason: this
# module is re-run on every window-title change, and Claude rewrites the title
# several times a second while it works, so anything paid here is paid at that
# rate. A machine where nothing has died has no crash file at all --
# wg_crashed_clear removes it rather than leaving {"crashed":[]} behind,
# precisely so this stays a [[ -f ]] and not a jq -- and the zero case is
# settled by that test alone: no state read, no window table, no state map,
# nothing this button does not need.
wg_crashed_button() {
  local -a rows=()
  if [[ -f $WG_CRASHED_FILE ]]; then
    mapfile -t rows < <(wg_crashed_rows)
  fi

  if (( ${#rows[@]} == 0 )); then
    # Exactly what a slot past the last group emits, so waybar draws nothing at
    # all rather than an empty button sitting there with a border on it.
    wg_emit "" "" ""
    return 0
  fi

  local tooltip row rest session cwd killed_at
  tooltip="$(printf '%d session(s) killed by systemd-oomd' "${#rows[@]}")"
  for row in "${rows[@]}"; do
    # Peeled apart by expansion, not `IFS=$'\t' read -r a b c`: the session id
    # column is empty for a session that was already running when the hook was
    # installed, and tab is IFS whitespace, so read would collapse that empty
    # column and slide the directory into the id. Same trap wg_row_split exists
    # for.
    session="${row%%$'\t'*}"
    rest="${row#*$'\t'}"
    cwd="${rest%%$'\t'*}"
    killed_at="${rest#*$'\t'}"
    # Whether the conversation comes back is the thing being decided when this
    # button is clicked, so it is on every line: without a recorded id all a
    # restore can offer is a fresh claude in the same directory.
    if [[ -n $session ]]; then
      tooltip+=$'\n'"$cwd — $(wg_crash_when "$killed_at") · resumable"
    else
      tooltip+=$'\n'"$cwd — $(wg_crash_when "$killed_at") · no session id, a fresh claude"
    fi
  done

  wg_emit "⚠${#rows[@]}" "$tooltip" crashed
}

main() {
  local slot="${1:?usage: wingroup-waybar <slot|crashed>}"

  # Not a slot. Answered before the slot path reads anything, because it needs
  # none of what that path builds -- and on the machine this is written for the
  # answer is "nothing died", which must cost nothing to give.
  if [[ $slot == crashed ]]; then
    wg_crashed_button
    return 0
  fi

  local state name label projects
  local -a names=()

  state="$(wg_state_read)"
  mapfile -t names < <(wg_state_group_names "$state")

  if (( slot >= ${#names[@]} )); then
    wg_emit "" "" ""
    return 0
  fi

  name="${names[slot]}"
  label="$(wg_state_group_field "$name" label "$state")"
  [[ -n $label ]] || label="$name"

  # wg_row_split, not a multi-variable `IFS=$'\t' read`: tab is IFS whitespace,
  # so a read across an empty interior column (an ungrouped window's group is
  # "") collapses and shifts status into $group -- group names are
  # user-slugified, so a group literally named "busy" or "idle" would then
  # corrupt these counts.
  #
  # A window is idle, busy, or neither: a plain terminal with no Claude session
  # in it counts towards the total and towards nothing else.
  #
  # Counted by the workspace it is on (column 3), not by the group that owns its
  # project (column 5). A group *is* a named workspace -- that is the whole
  # definition -- so whatever is sitting on it is in it, whoever happens to own
  # the directory.
  #
  # Counting by owner made the button contradict the screen. A session in a
  # project no group claims, moved onto a group's workspace by hand, was counted
  # by nobody: the window was visibly there and the button said zero. This file
  # already decides "active" and "visible" by workspace a few lines down, so the
  # two halves of the same button were answering to different notions of which
  # group they were describing.
  #
  # The cost is that a window still waiting on workspace 1 counts for no group
  # until it is filed onto one, which is the honest answer: it is not in a group
  # yet. The daemon files it within a moment of it opening.
  local total=0 idle=0 busy=0 line
  while IFS= read -r line; do
    wg_row_split "$line"
    [[ ${WG_ROW[3]} == "$name" ]] || continue
    total=$(( total + 1 ))
    case ${WG_ROW[6]} in
      idle) idle=$(( idle + 1 )) ;;
      busy) busy=$(( busy + 1 )) ;;
    esac
  done < <(if [[ -n ${WG_BAR_TABLE+x} ]]; then printf '%s\n' "$WG_BAR_TABLE"; else wg_window_table; fi)

  # Sessions systemd-oomd killed, narrowed to this group.
  #
  # This module is re-run on every window-title change, and Claude rewrites the
  # title several times a second while it works, so anything paid here is paid
  # at that rate: a journalctl call, a walk of /proc or a jq per window would
  # each be ruinous. The watcher does that work once, when a kill actually
  # happens, and leaves the answer in a file for this to read.
  #
  # Even reading that file is not free -- wg_crashed_rows is a mkdir and a jq --
  # so the common case is settled first, by a test that costs no processes at
  # all. A machine where nothing has died has no crash file: wg_crashed_clear
  # removes it rather than leaving an empty document behind, precisely so that
  # this stays a [[ -f ]] and not a jq for the rest of the boot.
  wg_crash_rows_load
  wg_group_crash_lines "$name" "$state"

  # activeworkspace answers for the focused monitor only, which on a
  # multi-monitor desktop is a lie by omission: a group can be on screen, in
  # full view, on the monitor that does not have focus. Ask every monitor.
  #
  # And "active" is a per-screen fact, not a global one. Waybar exports
  # WAYBAR_OUTPUT_NAME to a custom module's script, naming the monitor the bar
  # running this copy of the module is drawn on; with it, the group active on
  # the other screen is drawn as visible here instead of active on both bars.
  # Without it -- and it has not been confirmed that every waybar build and
  # config exports it -- the reference monitor is the focused one, which is
  # exactly the behaviour this module has always had.
  wg_monitors_load

  projects="$(jq -r --arg n "$name" \
    'first(.groups[] | select(.name == $n) | .projects) | join(", ")' <<<"$state")"

  WG_GROUP_NAMES=("${names[@]}")
  wg_slot_describe "$slot" "$name" "$label" "$projects" "$total" "$idle" "$busy"
  wg_emit "$WG_DESC_TEXT" "$WG_DESC_TOOLTIP" ${WG_DESC_CLASSES[@]+"${WG_DESC_CLASSES[@]}"}
}

# Where every monitor's active workspace is, from one query: WG_HERE is the
# reference monitor's, WG_ELSEWHERE every other monitor's. Asked once per
# redraw, not once per group -- the answer is the same for all of them. The
# reference monitor is the one WAYBAR_OUTPUT_NAME names, or the focused one.
WG_HERE=""
declare -ga WG_ELSEWHERE=()

wg_monitors_load() {
  local -a lines=()
  mapfile -t lines < <(wg_hypr_query monitors | jq -r \
    --arg out "${WAYBAR_OUTPUT_NAME:-}" '
      (if $out == "" then first(.[] | select(.focused == true))
       else first(.[] | select(.name == $out)) end // null) as $self
      | ($self.activeWorkspace.name // ""),
        (.[] | select(.name != ($self.name // "")) | .activeWorkspace.name // "")')
  WG_HERE="${lines[0]:-}"
  WG_ELSEWHERE=("${lines[@]:1}")
}

# Sessions systemd-oomd killed, as the crash file lists them, into WG_CRASH_ROWS
# -- or nothing, for free, when there is no crash file. Read once per redraw.
declare -ga WG_CRASH_ROWS=()

wg_crash_rows_load() {
  WG_CRASH_ROWS=()
  if [[ -f $WG_CRASHED_FILE ]]; then
    mapfile -t WG_CRASH_ROWS < <(wg_crashed_rows)
  fi
}

# The crashes in WG_CRASH_ROWS that belong to group $1, as tooltip lines, into
# WG_CRASH_LINES.
declare -ga WG_CRASH_LINES=()
WG_BAR_MAP_LOADED=0

wg_group_crash_lines() {
  local name="$1" state="$2" row rest cwd killed_at
  WG_CRASH_LINES=()
  (( ${#WG_CRASH_ROWS[@]} )) || return 0
  # wg_window_table loads WG_STATE_MAP too, but it runs inside a process
  # substitution -- the map it filled died with that subshell, so this is not
  # a duplicate load. It costs a jq, so it is paid only when there is a crash
  # to place, which on a machine that is behaving is never.
  if (( ! WG_BAR_MAP_LOADED )); then
    wg_state_map_load "$state"
    WG_BAR_MAP_LOADED=1
  fi
  for row in "${WG_CRASH_ROWS[@]}"; do
    # Peeled apart by expansion, not `IFS=$'\t' read -r a b c`: the session id
    # column is empty for a session that was already running when the hook was
    # installed, and tab is IFS whitespace, so read would collapse that empty
    # column and slide the directory into the id. Same trap wg_row_split
    # exists for.
    rest="${row#*$'\t'}"
    cwd="${rest%%$'\t'*}"
    killed_at="${rest#*$'\t'}"
    [[ "$(wg_crashed_group "$cwd")" == "$name" ]] || continue
    WG_CRASH_LINES+=("Crashed: $cwd — $(wg_crash_when "$killed_at")")
  done
}

# What one group's button says, from facts already gathered: its text, tooltip
# and classes, into WG_DESC_TEXT, WG_DESC_TOOLTIP and WG_DESC_CLASSES. Reads
# WG_HERE, WG_ELSEWHERE and WG_CRASH_LINES. No processes beyond a superscript's
# subshell, so describing every group costs what describing one did.
#
# The overflow line ("2 more: ...") is read off WG_GROUP_NAMES, every group's
# name in order, which the caller fills.
#
#   wg_slot_describe <slot> <name> <label> <projects> <total> <idle> <busy>
declare -ga WG_GROUP_NAMES=()
WG_DESC_TEXT=""
WG_DESC_TOOLTIP=""
declare -ga WG_DESC_CLASSES=()

wg_slot_describe() {
  local slot="$1" name="$2" label="$3" projects="$4"
  local total="$5" idle="$6" busy="$7"
  local elsewhere=0 ws
  for ws in ${WG_ELSEWHERE[@]+"${WG_ELSEWHERE[@]}"}; do
    [[ $ws == "$name" ]] && elsewhere=$(( elsewhere + 1 ))
  done

  local class=""
  if [[ $WG_HERE == "$name" ]]; then
    class="active"
  elif (( elsewhere > 0 )); then
    class="visible"
  elif (( busy > 0 )); then
    class="busy"
  fi

  # The state above is one of four and says where the group is. Idle heat is a
  # separate fact about the same group -- how much finished work is sitting in
  # it waiting to be picked up -- so it is a second class next to the first,
  # never instead of it: a group can be the one you are looking at *and* have
  # three sessions waiting in it. Zero idle sessions emit no idle class at all,
  # so a group with nothing waiting looks exactly as it always has.
  local -a classes=()
  [[ -z $class ]] || classes+=("$class")
  if (( idle > 0 )); then
    local heat="$idle"
    if (( heat > WG_IDLE_HEAT_MAX )); then
      heat="$WG_IDLE_HEAT_MAX"
    fi
    classes+=("idle$heat")
  fi
  # A crash is a third fact about the same group, independent of the other two:
  # a group can be the one you are looking at, warm with idle sessions, and
  # still be short a session oomd took while you were elsewhere. So it is
  # another class beside them, never instead of one.
  (( ${#WG_CRASH_LINES[@]} == 0 )) || classes+=("crashed")

  local tooltip
  printf -v tooltip '%s — %d windows · %d idle · %d busy' "$label" "$total" "$idle" "$busy"
  # Directly under the counts, above the projects: what died is the one thing in
  # here that needs doing something about, and `wingroup crashed --restore` is
  # what does it.
  local crash_line
  for crash_line in ${WG_CRASH_LINES[@]+"${WG_CRASH_LINES[@]}"}; do
    tooltip+=$'\n'"$crash_line"
  done
  [[ -n $projects ]] && tooltip+=$'\n'"Projects: $projects"

  if (( slot == WG_SLOTS - 1 && ${#WG_GROUP_NAMES[@]} > WG_SLOTS )); then
    local -a overflow=("${WG_GROUP_NAMES[@]:WG_SLOTS}")
    local joined
    printf -v joined '%s, ' "${overflow[@]}"
    tooltip+=$'\n'"${#overflow[@]} more: ${joined%, }"
  fi

  # The superscript counts idle sessions, not busy ones: the point of the bar is
  # spotting a Claude session that has finished and can be given the next thing.
  WG_DESC_TEXT="$label$(wg_superscript "$idle")"
  WG_DESC_TOOLTIP="$tooltip"
  WG_DESC_CLASSES=(${classes[@]+"${classes[@]}"})
}

# Every group, and the crash button's state, as one JSON document:
#
#   {"groups": [{"name": ..., "text": ..., "tooltip": ..., "class": ...}, ...],
#    "crashed": {"text": ..., "tooltip": ..., "class": ...}}
#
# For a bar that draws all the groups itself, which is what Omarchy 4's shell
# does -- it replaced waybar, and a bar-widget plugin asks once and draws every
# button from the answer.
#
# Once is the point. Waybar ran this script once per slot, and every run built
# the whole window table to describe a single group: eight slots, the same
# table eight times, 1.74 seconds of work per redraw on a desktop with eight
# groups. Here the table is built once and handed to every slot.
#
# And everything else is read once per redraw too. This used to run each slot's
# main() in a subshell, which re-read the state file and asked jq and hyprctl
# the same questions for every group -- eight processes a group, 0.5 of the
# 0.64 seconds a redraw took on nine groups, and the bar redraws on every window
# title change. Now the state, the monitors and the counts are read once, every
# group is described in this process, and one jq writes the document.
wg_bar_all() {
  local state line name label projects rest ws i
  state="$(wg_state_read)"

  WG_BAR_TABLE="$(wg_window_table)"

  # Name, label and projects of every group, one tab-separated line each.
  local -a rows=()
  mapfile -t rows < <(jq -r '.groups[]
    | [.name, (.label // ""), ((.projects // []) | join(", "))] | join("\t")' <<<"$state")
  WG_GROUP_NAMES=()
  for line in ${rows[@]+"${rows[@]}"}; do
    WG_GROUP_NAMES+=("${line%%$'\t'*}")
  done

  # Every window counted onto the workspace it is on, in one pass -- main()
  # says why by workspace, and why wg_row_split.
  local -A total=() idle=() busy=()
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    wg_row_split "$line"
    ws="${WG_ROW[3]}"
    [[ -n $ws ]] || continue
    total["$ws"]=$(( ${total["$ws"]:-0} + 1 ))
    case ${WG_ROW[6]} in
      idle) idle["$ws"]=$(( ${idle["$ws"]:-0} + 1 )) ;;
      busy) busy["$ws"]=$(( ${busy["$ws"]:-0} + 1 )) ;;
    esac
  done <<<"$WG_BAR_TABLE"

  wg_monitors_load
  wg_crash_rows_load

  # Four arguments a group for the one jq below: name, text, tooltip, and the
  # classes space-separated.
  local -a args=()
  for i in "${!rows[@]}"; do
    line="${rows[i]}"
    name="${line%%$'\t'*}"
    rest="${line#*$'\t'}"
    label="${rest%%$'\t'*}"
    projects="${rest#*$'\t'}"
    [[ -n $label ]] || label="$name"
    wg_group_crash_lines "$name" "$state"
    wg_slot_describe "$i" "$name" "$label" "$projects" \
      "${total["$name"]:-0}" "${idle["$name"]:-0}" "${busy["$name"]:-0}"
    args+=("$name" "$WG_DESC_TEXT" "$WG_DESC_TOOLTIP" "${WG_DESC_CLASSES[*]-}")
  done

  # Each group in wg_emit's shape -- "class" a list when there are several, else
  # the one name or "" -- with its name after.
  jq -cn --argjson c "$(main crashed)" '
    $ARGS.positional as $a
    | {groups: [range(0; $a | length; 4) as $i
        | {text: $a[$i + 1], tooltip: $a[$i + 2],
           class: ($a[$i + 3] | split(" ") | map(select(. != ""))
                   | if length > 1 then . else (.[0] // "") end),
           name: $a[$i]}],
       crashed: $c}' --args -- ${args[@]+"${args[@]}"}
}

if [[ ${1:-} == --all ]]; then
  wg_bar_all
else
  main "$@"
fi
